# Build from the repository root:
# docker build -f web_interface/Containerfile -t bincovering .
FROM python:3.11-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY pyproject.toml requirements.lock ./
COPY src ./src
COPY configs ./configs
RUN pip install --no-cache-dir -c requirements.lock '.[web,plot]'
EXPOSE 5000
# Mount /app/outputs for durable experiment storage.
CMD ["python", "-c", "from bincovering.web.app import create_app; create_app('/app/outputs').run(host='0.0.0.0', port=5000, debug=False)"]
