# Build from the repository root.
FROM python:3.11-slim AS native
RUN apt-get update && apt-get install -y --no-install-recommends g++ && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY cpp ./cpp
RUN g++ -std=c++17 -O3 -DNDEBUG -Icpp/include cpp/src/main.cpp -o bincovering-native

FROM python:3.11-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MPLCONFIGDIR=/app/outputs/.cache/matplotlib
COPY pyproject.toml requirements.lock ./
COPY src ./src
COPY configs ./configs
COPY cpp ./cpp
COPY --from=native /build/bincovering-native ./build/bincovering-native
RUN pip install --no-cache-dir -c requirements.lock '.[web,plot]'
EXPOSE 5000
# Mount /app/outputs for durable experiment storage.
CMD ["python", "-c", "from bincovering.web.app import create_app; create_app('/app/outputs').run(host='0.0.0.0', port=5000, debug=False)"]
